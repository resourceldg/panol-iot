# Copiar a .env y ajustar. El .env real NO va al repositorio.
#
# PUERTOS: ninguno usa el valor por defecto de su servicio. Los defaults
# (1883, 9001, 1880, 5432) están tunelizados para otras cosas en este
# equipo, así que todo lo publicado al host vive en el bloque 18000.
# Adentro de la red de Docker los servicios siguen hablando por sus puertos
# estándar: lo que se remapea es solo la salida al host.

# --- Puertos publicados al host ------------------------------------------
PUERTO_MQTT=18830          # en vez de 1883
PUERTO_MQTT_WS=19001       # en vez de 9001
PUERTO_NODERED=18800       # en vez de 1880
PUERTO_API=18500
PUERTO_POSTGRES=15432      # en vez de 5432

# --- Base de datos --------------------------------------------------------
POSTGRES_DB=panol
POSTGRES_USER=panol
POSTGRES_PASSWORD=cambiar_esta_clave

# --- Broker MQTT ----------------------------------------------------------
# El broker local es anónimo, así que estas credenciales no las valida nadie.
# Importan cuando el puente apunta al broker del homelab, que sí autentica:
# ahí tienen que ser las mismas que entrega `sudo cat /etc/panol/app.env`.
MQTT_USER=panol-servidor
MQTT_PASSWORD=cambiar-servidor-panol

# --- Zona horaria ---------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
